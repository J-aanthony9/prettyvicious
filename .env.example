# Pretty Vicious storefront environment
#
# Both values come from the Shopify custom app you create in
# Settings > Apps and sales channels > Develop apps.
# See SETUP.md for the click by click walkthrough.

# Your store domain. Use the free myshopify.com URL, not the custom domain.
# The custom domain points at Cloudflare Pages, not at Shopify.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (public scope). Safe to ship to the browser,
# but we only ever read it on the server. Never put an Admin API token here.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Pin the Storefront API version. Defaults to a known good version.
# SHOPIFY_STOREFRONT_API_VERSION=2026-04

# Public site URL, used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=https://prettyvicious.com

# Optional. Where club signups are POSTed as {"email":"...","source":"..."}.
# Works with Klaviyo, Mailchimp, Beehiiv, or a Zapier/Make catch hook.
# Leave unset and signups are only written to the server log.
CLUB_SIGNUP_WEBHOOK_URL=
